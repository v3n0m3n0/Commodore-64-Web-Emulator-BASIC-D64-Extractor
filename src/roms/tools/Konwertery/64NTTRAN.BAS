 0  POKE 56579,7: POKE 56577,0
 1  DEF FNP(A) =  PEEK (56577)
 10  INPUT "FILENAME TO SAVE TO";f$
 20  OPEN  1,8,1,f$
 30 ch =  ASC ("X"): GOSUB 1000
 40 ch =  ASC ("I"): GOSUB 1000
 50  PRINT "CONNECTION MADE"
 60  GOSUB 1100:ch = ch AND 15
 70  IF ch <> 1 THEN 90
 80  GOSUB 1100: PRINT#1, CHR$ (ch);: GOTO 60
 90  IF ch <> 2 THEN 140
 100  GOSUB 1100: PRINT   CHR$ (ch);: GOTO 60
 140  IF ch <> 4 THEN 60
 150  REM transfer complete.
 160  PRINT : PRINT "CONNECTION CLOSED"
 170  CLOSE 1
 180  END 
 1000  REM  send a character to 64net
 1010  POKE 56577,(ch AND 3) + 4
 1020  IF ( FNP(.) AND 16) <  > 16 THEN 1020
 1030  POKE 56577, INT (ch / 4) AND 3
 1040  IF ( FNP(.) AND 240) <  > 32 THEN 1040
 1050  POKE 56577,4 + ( INT (ch / 16) AND 3)
 1060  IF ( FNP(.) AND 96) <  > 96 THEN 1060
 1070  POKE 56577, INT (ch / 64) AND 3
 1080  IF ( FNP(.) AND 240) <  > 16 THEN 1080
 1090  RETURN 
 1100  REM  receive a character from 64net
 1110  POKE  56577,4
 1120  IF ( FNP(.) AND 8) = 0 THEN 1120
 1130 ch =  INT ( FNP(.) / 16): POKE 56577,0
 1140  IF ( FNP(.) AND 8) = 8 THEN 1140
 1150 ch = ch  OR ( FNP(.) AND 240)
 1160  RETURN 
